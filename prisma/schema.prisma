// M1 데이터 모델 — specs/001-taste-profile/data-model.md 의 Prisma 스키마 초안을 그대로 옮겼다.
//
// ⚠️ Prisma 7 주의 (research.md 작성 시점 이후 바뀐 것):
//  - datasource 에 url 을 쓸 수 없다 (P1012). 런타임 연결은 lib/prisma.ts 가
//    @prisma/adapter-pg 어댑터로 만들고, DATABASE_URL 은 .env.local 에서 읽는다.
//  - 마이그레이션 CLI(T009~T010)는 prisma.config.ts 에 연결 설정이 따로 필요하다.
//  - (profileId, kind, categoryId, detail) 유니크는 NULLS NOT DISTINCT 라서
//    Prisma 문법으로 표현되지 않는다 — T010 raw SQL 마이그레이션으로 넣는다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TasteKind {
  WANT // 원하는 것
  HAVE // 이미 있는 것
  UNWANTED // 필요 없는 것
}

model User {
  id          String   @id @db.Uuid // = auth.users.id. 기본값 없음 — 세션에서 받는다 (R2)
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasteProfile TasteProfile?

  // M2 역참조 (data-model.md "M1 스키마에 미치는 영향" — User 컬럼은 바꾸지 않는다).
  // Friendship 은 User 를 세 번 참조(requester·addressee·removedBy)하므로 관계 이름이 필수다.
  friendshipsRequested Friendship[]       @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]       @relation("FriendshipAddressee")
  friendshipsRemoved   Friendship[]       @relation("FriendshipRemovedBy")
  inviteLinks          FriendInviteLink[]
  notifications        Notification[]

  // M3 역참조 (specs/003 data-model — User 컬럼은 바꾸지 않는다).
  // GiftRequest 는 User 를 두 번 참조(giver·receiver)하므로 관계 이름이 필수다.
  paymentMethods       PaymentMethod[]
  giftRequestsSent     GiftRequest[]      @relation("GiftGiver")
  giftRequestsReceived GiftRequest[]      @relation("GiftReceiver")
  events               Event[]
}

model TasteProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid // D1 — 1:1 강제
  description String? // 취향 서술. 선택 (FR-007)
  onboardedAt DateTime? // FR-008 판정 결과
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items TasteItem[]
}

model Category {
  id        String @id @default(uuid()) @db.Uuid
  name      String @unique // 멱등 시드(upsert)의 키
  sortOrder Int // 배열 순서 = 화면 순서. 묶음은 DB에 넣지 않는다 (categories.md §3 철회 결정)

  items    TasteItem[]
  products Product[] // M3 — 취향 항목과 상품이 공유하는 단일 마스터 (FR-002)

  @@index([sortOrder])
}

model TasteItem {
  id         String    @id @default(uuid()) @db.Uuid
  profileId  String    @db.Uuid
  kind       TasteKind
  categoryId String    @db.Uuid // 자유 텍스트 금지 (FR-004)
  detail     String? // 선택 (FR-006)
  productId  String?   @db.Uuid // M3 — 위시리스트 "카탈로그에서 고르기" (FR-044). 텍스트 경로 유지, 기존 행은 전부 NULL
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  profile  TasteProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  product  Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([profileId, kind])
  // C2 유니크 (T010). 실제 제약은 NULLS NOT DISTINCT 인데 Prisma 문법으로 표현되지
  // 않아 raw SQL 마이그레이션(20260828011025)으로 넣었다. 여기 @@unique 는 diff 가
  // 그 제약을 지우려 들지 않게 하는 매핑이다 — `db push` 로 새 DB 를 만들면
  // NULLS DISTINCT 로 생기므로, 새 환경은 반드시 `migrate deploy` 로 만든다.
  @@unique([profileId, kind, categoryId, detail], map: "TasteItem_profile_kind_category_detail_key")
}

// ---------------------------------------------------------------------------
// M2 — 친구에게 취향이 전달된다 (specs/002-friend-taste-sharing/data-model.md)
// M1 모델(User·TasteProfile·Category·TasteItem)은 바꾸지 않는다. User 에는 역참조만 더했다.
// ---------------------------------------------------------------------------

enum FriendshipStatus {
  ACTIVE
  REMOVED // 해제는 삭제가 아니라 상태 전이 (R9). 재추가는 새 행이다 — REMOVED→ACTIVE 전이 없음
}

enum NotificationType {
  FRIEND_JOINED_VIA_LINK // M2 (R6)
  // M3 gift 6종 — 만드는 곳이 정해져 있다 (specs/003 data-model, R7).
  // funding 4종은 M4 에서 추가한다 (원칙 V).
  GIFT_REQUEST_RECEIVED // 수령자 ← createGiftRequest 트랜잭션
  GIFT_COUNTERED // 주는 사람 ← counterGift 액션
  GIFT_PAID // 양쪽 ← chargeGiftRequest()
  GIFT_PAYMENT_FAILED // 주는 사람 ← chargeGiftRequest()
  GIFT_CANCELLED_BY_PAYMENT // 수령자 ← chargeGiftRequest() 상한 초과 확정 시. 누락 금지 (FR-032)
  GIFT_EXPIRED // 주는 사람 ← evaluateExpiry() 만료 확정 지점 (R3)
}

// 친구 관계 — 한 쌍당 한 행. 양방향으로 복제하지 않는다 (도메인 모델 §4).
model Friendship {
  id           String           @id @default(uuid()) @db.Uuid
  requesterId  String           @db.Uuid // 링크 발급자 — "누가 먼저 요청했나"
  addresseeId  String           @db.Uuid // 링크를 받은 쪽
  status       FriendshipStatus @default(ACTIVE)
  inviteLinkId String?          @db.Uuid // 어느 링크로 맺어졌는지
  acceptedAt   DateTime         @default(now())
  removedAt    DateTime? // D3
  removedBy    String?          @db.Uuid // 어느 쪽이 끊었는지 (FR-027)

  requester  User              @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee  User              @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  remover    User?             @relation("FriendshipRemovedBy", fields: [removedBy], references: [id], onDelete: SetNull)
  inviteLink FriendInviteLink? @relation(fields: [inviteLinkId], references: [id], onDelete: SetNull)

  // ⚠️ 아래 두 제약은 Prisma 문법으로 표현되지 않아 raw SQL 마이그레이션으로 넣었다 (R4).
  //   C3 friendship_pair_active — UNIQUE (LEAST(requesterId,addresseeId), GREATEST(...)) WHERE status <> 'REMOVED'
  //   C4 friendship_not_self    — CHECK (requesterId <> addresseeId)
  // `db push` 로 만든 DB 에는 둘 다 없다. 새 환경은 반드시 `migrate deploy` 로 만든다.
  // 걸렸는지는 tests/integration/friendship-constraints.test.ts 가 판정한다.

  // 한 행이 양방향을 담으므로 친구 목록(FR-018)은 양쪽에서 찾는다.
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

// 친구 초대 링크 — 유효성은 지연 평가: isValid := revokedAt IS NULL AND expiresAt > now() (도메인 모델 §8).
model FriendInviteLink {
  id        String    @id @default(uuid()) @db.Uuid
  inviterId String    @db.Uuid
  token     String    @unique // 32바이트 랜덤 base64url, 43자 (R2)
  expiresAt DateTime // 발급 + 7일 (FR-003)
  revokedAt DateTime? // 발급자가 즉시 중지 (FR-005)
  usedCount Int       @default(0) // 사용 인원수 (FR-006). 상한 없음 (clarify Q2)
  createdAt DateTime  @default(now())

  inviter     User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  friendships Friendship[]

  @@index([inviterId]) // 발급자의 링크 목록 (SCR-M2-03)
}

// 알림 — 원래 M3 엔티티였으나 M2 로 앞당겼다 (clarify Q4).
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid // 받는 사람
  type      NotificationType
  payload   Json // 관련 엔티티 id + 표시용 값의 스냅샷 (예: friendDisplayName 을 복사해 넣는다)
  readAt    DateTime? // 미읽음 구분 (FR-030)
  createdAt DateTime         @default(now()) // 최신순 정렬 (FR-029)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt]) // 목록 조회
  @@index([userId, readAt]) // 미읽음 개수
}

// ---------------------------------------------------------------------------
// M3 — 선물이 수령자 확인을 거쳐 결정된다 (specs/003-gift-request-payment/data-model.md)
// M1·M2 모델의 기존 필드는 바꾸지 않는다 — User·Category 에는 역참조만,
// TasteItem 에는 productId 컬럼 하나만 더했다. NotificationType 은 값 6종 추가.
// ---------------------------------------------------------------------------

enum GiftStatus {
  PENDING
  PAYING // 멱등성 장치 — PENDING→PAYING 조건부 UPDATE 가 0행이면 이미 진행 중이므로 중단 (R2)
  PAID
  PAYMENT_FAILED
  EXPIRED
  CANCELLED
  // DECLINED 은 없다 — 거절이 아닌 대안 제시로 읽혀야 한다는 요구사항의 구현 (FR-020)
}

enum GiftResolution {
  APPROVED
  COUNTERED // 상태가 아니라 지나간 경로의 기록 — 승인률 집계가 이 필드 하나로 (FR-045)
}

enum PaymentStatus {
  READY
  PAID
  FAILED
  CANCELLED
  REFUNDED // M4 환불에서 처음 쓰인다
}

enum PaymentMethodStatus {
  ACTIVE
  EXPIRED
  DELETED // 삭제는 soft — 과거 요청의 cardLast4 표시가 남아야 한다 (SCR-M3-07)
}

enum EventType {
  BIRTHDAY
  ANNIVERSARY
  CUSTOM
}

// 상품 — 시드 카탈로그 (자체 커머스는 범위 밖). 삭제 대신 isActive=false 로 내린다.
model Product {
  id         String  @id @default(uuid()) @db.Uuid
  name       String // 부분 일치 검색 대상 (R9)
  categoryId String  @db.Uuid // 취향 항목과 같은 마스터 — unwanted 필터가 조인 한 번으로 된다 (FR-002)
  price      Int // 원 단위 정수
  imageUrl   String?
  isActive   Boolean @default(true) // false 면 카탈로그·상세 진입 차단. 기존 요청은 스냅샷으로 렌더

  category            Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tasteItems          TasteItem[]
  giftRequests        GiftRequest[] @relation("GiftRequestProduct")
  counterGiftRequests GiftRequest[] @relation("GiftRequestCounterProduct")

  @@index([categoryId, isActive]) // 목록·대상 필터
  @@index([isActive, price]) // 상한 필터(SCR-M3-13) · 추천 가격 정렬 (R9)
}

// 결제수단 — 빌링키만 저장(AES-256-GCM 암호화, R10). 카드번호·CVC 는 어디에도 없다 (FR-008).
// 빌링키는 사용자당 재사용 — 등록은 한 번, 동의는 요청마다 (FR-009).
model PaymentMethod {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  provider   String // 'portone'
  billingKey String // 암호화 저장 — 평문 금지 (R10)
  cardBrand  String // 화면 표시 전용
  cardLast4  String // 화면 표시 전용. mock 실패 규약의 키 ('0000', R1)
  status     PaymentMethodStatus @default(ACTIVE)
  createdAt  DateTime            @default(now())
  deletedAt  DateTime? // 삭제는 soft — 과거 요청의 표시(cardLast4)가 남아야 한다

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  giftRequests GiftRequest[]

  @@index([userId, status]) // "활성 수단 존재" 검증(FR-013 ②)과 관리 화면
}

// 선물 요청 — 이 마일스톤의 중심. 화면은 스냅샷 필드만 읽는다 (R5 — Product·User 조인 렌더 금지).
model GiftRequest {
  id         String          @id @default(uuid()) @db.Uuid
  giverId    String          @db.Uuid
  receiverId String          @db.Uuid // C7 — 자기 자신 금지
  status     GiftStatus      @default(PENDING)
  resolution GiftResolution? // 어느 경로로 확정됐는지 (FR-045)
  resolvedAt DateTime?

  productId       String @db.Uuid // 이력 추적용 참조 — 렌더에 쓰지 않는다 (R5)
  productSnapshot Json // 이름·이미지·가격. 생성 시 복사 (FR-016)
  requestedAmount Int // C5 의 상한 기준

  counterProductId       String?   @db.Uuid // C6 — 3필드 전무/전유
  counterProductSnapshot Json? // C6
  counterAmount          Int? // C5: ≤ requestedAmount. 화면 필터가 1차, CHECK 가 최종 방어선 (FR-021)
  counteredAt            DateTime?
  finalAmount            Int? // 결제 시 확정 = counterAmount ?? requestedAmount

  receiverDisplayName     String // D3 스냅샷 — 해제 후에도 "누구에게"가 렌더된다
  shippingAddressSnapshot Json? // 수령자가 이 거래에 제공한 것. 프로필 배송지 없음 (FR-025)

  paymentMethodId String   @db.Uuid // 재시도 시 변경 가능 (FR-030)
  consentAgreedAt DateTime // 동의 없이 생성 불가 (FR-014)
  consentVersion  String // 어떤 문구에 동의했는지. v1 = clarify Q4 (FR-015)

  respondDueAt        DateTime // 생성 시 절대 시각 스냅샷 (FR-017, R11) — TTL 을 바꿔도 이미 뜬 요청은 불변
  paymentRetryUntil   DateTime? // 첫 실패 시점 + GIFT_PAYMENT_RETRY_WINDOW
  paymentAttemptCount Int       @default(0) // GIFT_PAYMENT_MAX_ATTEMPTS 상한 (FR-031)

  paidAt      DateTime?
  expiredAt   DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  giver          User          @relation("GiftGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver       User          @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  product        Product       @relation("GiftRequestProduct", fields: [productId], references: [id], onDelete: Restrict)
  counterProduct Product?      @relation("GiftRequestCounterProduct", fields: [counterProductId], references: [id], onDelete: Restrict)
  paymentMethod  PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict) // 하드 삭제 금지 — 수단 삭제는 status 로 soft (FR-011)
  payments       Payment[]

  // ⚠️ 아래 세 제약은 Prisma 문법으로 표현되지 않아 raw SQL 마이그레이션으로 넣었다 (R4).
  //   C5 gift_counter_le_requested — CHECK counterAmount ≤ requestedAmount (PRD 확정 정책의 최종 방어선)
  //   C6 gift_counter_all_or_none  — counter 3필드는 전부 NULL 이거나 전부 NOT NULL
  //   C7 gift_no_self              — CHECK giverId <> receiverId
  // `db push` 로 만든 DB 에는 셋 다 없다. 새 환경은 반드시 `migrate deploy` 로 만든다.
  // 걸렸는지는 tests/integration/gift-constraints.test.ts 가 판정한다.

  @@index([receiverId, status, respondDueAt]) // 홈 승인 대기(임박순) + 수신 목록 (FR-038)
  @@index([giverId, status]) // 보낸 내역·진행 중 구분 (FR-042)
  @@index([paymentMethodId, status]) // 수단 삭제 시 "진행 중 N건" 경고 (FR-011)
}

// 결제 기록 — polymorphic(payableType+payableId) 대신 nullable FK 2개 + C8(XOR).
// DB 가 참조 무결성을 계속 지킨다. 결제 데이터에서 이것을 양보하지 않는다 (도메인 모델 §5).
model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  provider     String // 'portone' (mock 포함)
  providerTxId String // mock 은 mock_ 접두 uuid
  amount       Int
  status       PaymentStatus
  giftRequestId String?      @db.Uuid // C8
  // M4 FundingContribution 대상 — 컬럼만 선반영, FK 는 M4 F1 에서 ADD CONSTRAINT 한 줄 (R4).
  // 지금 컬럼이 없으면 C8 을 줄여 걸었다가 M4 에서 제약을 떨어뜨리고 다시 걸어야 한다.
  fundingContributionId String? @db.Uuid
  paidAt       DateTime?
  refundedAt   DateTime?
  createdAt    DateTime      @default(now())

  // SetNull 은 C8 을 깨므로 Restrict — 결제 이력은 대상보다 오래 남는다
  giftRequest GiftRequest? @relation(fields: [giftRequestId], references: [id], onDelete: Restrict)

  // ⚠️ C8 payment_exactly_one_target — 정확히 하나의 대상에 연결(XOR CHECK). raw SQL (R4).
  // `db push` 로 만든 DB 에는 없다. tests/integration/gift-constraints.test.ts 가 판정한다.

  @@index([giftRequestId]) // 요청별 시도 이력 (FR-033)
}

// 일정 — 생일을 User.birthday 필드로 두지 않고 Event 로 통일한다.
// 홈 탭이 "다가오는 일정" 하나의 축으로 돈다 (도메인 모델 §5). 캘린더는 목록형 (clarify Q2).
model Event {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid // 일정의 주체 (생일의 주인)
  type        EventType
  title       String
  date        DateTime  @db.Date
  isRecurring Boolean // true 면 연도를 무시하고 월·일로 매칭 (FR-040)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date]) // 본인·친구 일정 조회
}
