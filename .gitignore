# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 팀 공유용 예시 파일은 커밋한다 (T004). 값은 들어 있지 않다.
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- 프로젝트 전용 ---
# 개인 메모 — 필요 시 추적 대상에 추가
idation.rtf

# Claude Code 로컬 설정
.claude/settings.local.json

# git worktree (세션별 병렬 작업용)
/.worktrees/

# 상품 사진 원본 (제출 전 변환 소스) — public/products/ 의 webp 만 추적한다.
# 원본은 6.5MB 이고 변환 결과는 1.6MB 다. 둘 다 넣을 이유가 없다.
/product-photos/

# PT 촬영 스크립트가 쓰는 중간 산출물 (상태 JSON · 보드 HTML · 디버그 캡처).
# 재촬영 스크립트는 scripts/pt-shots/ 에, 결과물은 pt-shots/ 에 추적한다.
/.pt-tmp/
