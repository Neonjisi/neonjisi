# 넌지시 — 환경 변수 예시
#
# 이 파일을 .env.local 로 복사한 뒤 각자 값을 채운다 (tasks.md T006).
#   cp .env.example .env.local
#
# ⚠️ .env.local 은 절대 커밋하지 않는다.
#    슬랙·카톡·이슈에 붙여넣는 것도 같은 유출이다. 각자 Supabase 대시보드에서 직접 가져온다.

# Prisma 가 런타임에 사용하는 PostgreSQL 연결 문자열 — **Transaction pooler** (포트 6543)
# Supabase 대시보드 → 상단 [Connect] 버튼 → Transaction pooler 탭
# 서버리스(Vercel) 환경에서 커넥션이 고갈되지 않도록 반드시 pooler 쪽을 쓴다.
DATABASE_URL=

# 마이그레이션(prisma migrate) 전용 직결 연결 — **Session pooler** (포트 5432)
# Supabase 대시보드 → 상단 [Connect] 버튼 → Session pooler 탭
# Transaction pooler 는 prepared statement 를 지원하지 않아 migrate 가 실패한다.
# (Direct connection 은 IPv6 전용이라 로컬에서 안 붙을 수 있다 — Session pooler 권장)
DIRECT_URL=

# 브라우저에 노출되는 값 (NEXT_PUBLIC_ 접두사)
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → anon public
# anon key 는 공개되어도 되는 키다. service_role 키를 여기 넣지 않는다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (선택) 인증 연동 전 로컬 화면 프리뷰 - proxy.ts 의 로그인 게이트를 우회한다. development 에서만 동작.
# PREVIEW_BYPASS_AUTH=1
