# 넌지시 — 환경 변수 예시
#
# 이 파일을 .env.local 로 복사한 뒤 각자 값을 채운다 (tasks.md T006).
#   cp .env.example .env.local
#
# ⚠️ .env.local 은 절대 커밋하지 않는다.
#    슬랙·카톡·이슈에 붙여넣는 것도 같은 유출이다. 각자 Supabase 대시보드에서 직접 가져온다.

# Prisma 가 런타임에 사용하는 PostgreSQL 연결 문자열 — **Transaction pooler** (포트 6543)
# Supabase 대시보드 → 상단 [Connect] 버튼 → Transaction pooler 탭
# 서버리스(Vercel) 환경에서 커넥션이 고갈되지 않도록 반드시 pooler 쪽을 쓴다.
DATABASE_URL=

# 마이그레이션(prisma migrate) 전용 직결 연결 — **Session pooler** (포트 5432)
# Supabase 대시보드 → 상단 [Connect] 버튼 → Session pooler 탭
# Transaction pooler 는 prepared statement 를 지원하지 않아 migrate 가 실패한다.
# (Direct connection 은 IPv6 전용이라 로컬에서 안 붙을 수 있다 — Session pooler 권장)
DIRECT_URL=

# 브라우저에 노출되는 값 (NEXT_PUBLIC_ 접두사)
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → anon public
# anon key 는 공개되어도 되는 키다. service_role 키를 여기 넣지 않는다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (선택) 인증 연동 전 로컬 화면 프리뷰 - proxy.ts 의 로그인 게이트를 우회한다. development 에서만 동작.
# PREVIEW_BYPASS_AUTH=1

# (선택) E2E 테스트 계정 — Playwright 가 이 계정으로 로그인해 수용 시나리오를 돌린다
# (tests/e2e/fixtures/auth.ts). Google OAuth 는 자동화할 수 없어 이메일/비밀번호 계정을 따로 둔다.
#   1. Supabase → Authentication → Sign In / Providers → Email 을 켠다
#   2. Supabase → Authentication → Users → Add user → Create new user (Auto Confirm User 체크)
#   3. 아래 두 값을 채운다. 비어 있으면 인증이 필요한 E2E 는 실패가 아니라 skip 된다.
# ⚠️ E2E 는 이 계정의 취향 데이터를 매번 지우고 다시 만든다 — 실사용 계정을 넣지 않는다.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# (선택) M2 두 번째 E2E 테스트 계정 (tasks.md T001·T002)
# M2 의 모든 시나리오가 "A가 링크를 만들고 B가 받는" 두 주체 구조라 계정 하나로는 검증이
# 안 된다 — 자기 자신과는 친구가 될 수 없다 (FR-016).
# 만드는 법은 위 계정과 같다 (Add user → Auto Confirm User 체크). 실제 메일함은 필요 없다.
# ⚠️ 비어 있으면 두 계정이 필요한 E2E 는 실패가 아니라 skip 된다 — `skipped` 수를 확인한다.
# ⚠️ 위 E2E_USER_EMAIL 과 반드시 다른 계정이어야 한다.
E2E_USER2_EMAIL=
E2E_USER2_PASSWORD=

# --- 마일스톤 3 (specs/003-gift-request-payment, tasks.md T001) ---

# 결제 모드 — mock | real (기본 mock). E2E·수동 검증은 **항상 mock** 이다.
# 실키로 E2E 를 돌리면 테스트가 실결제를 만든다 (team-assignment §6).
# mock 실패 규약: 카드 뒷자리를 0000 으로 등록한 결제수단은 결제가 항상 실패한다 (research R1).
PORTONE_MODE=mock

# 빌링키 AES-256-GCM 암호화 키 — 32바이트 base64 (research R10)
#   openssl rand -base64 32     (또는) node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ 각자 따로 생성한다. 이 값이 바뀌면 기존에 저장된 빌링키는 복호화되지 않는다.
BILLING_KEY_ENCRYPTION_KEY=

# 수령자 응답 제한 시간 — 요청 생성 시점에 절대 시각으로 스냅샷된다 (research R11).
# 검증 중에 늘려도 이미 뜬 요청의 마감은 흔들리지 않는다.
GIFT_RESPOND_TTL=5m

# 결제 실패 후 재시도를 받아주는 기간 · 최대 시도 횟수 (research R11)
GIFT_PAYMENT_RETRY_WINDOW=24h
GIFT_PAYMENT_MAX_ATTEMPTS=3

# --- PortOne 실연동 (tasks.md T058) — PORTONE_MODE=real 일 때만 읽는다 ---
# mock 검증(E2E·수동)에는 아래 3개가 전부 비어 있어도 된다.

# 상점 아이디 — PortOne 콘솔 → 결제 연동 → 연동 정보 (store- 로 시작)
PORTONE_STORE_ID=

# 채널 키 — PortOne 콘솔 → 결제 연동 → 채널 관리 (channel-key- 로 시작)
# ⚠️ 반드시 "테스트 채널"의 키를 쓴다. 실 채널 키를 넣는 순간 실청구가 된다.
PORTONE_CHANNEL_KEY=

# V2 API Secret — PortOne 콘솔 → 결제 연동 → 식별코드 · API Keys → V2 API Secret
# 서버 전용 비밀키 — NEXT_PUBLIC_ 접두사 금지. 슬랙·카톡·이슈 공유도 유출이다.
PORTONE_API_SECRET=

# --- 마일스톤 4 (specs/004-group-funding, tasks.md T001·T003) ---

# 세 번째 E2E 테스트 계정 — 펀딩은 3주체 구조다 (A=주최자 · B=수령자 · C=참여자).
# 만드는 법은 위 계정과 같다 (Add user → Auto Confirm User 체크).
# ⚠️ 비어 있으면 세 계정이 필요한 E2E 는 실패가 아니라 skip 된다 — `skipped` 수를 확인한다.
# ⚠️ 위 두 계정과 반드시 다른 계정이어야 한다 (fixtures/auth.ts 가 같으면 던진다).
E2E_USER3_EMAIL=
E2E_USER3_PASSWORD=

# 참여 예약 유효 시간 (research R2) — 예약이 잔여를 선점하는 시간. 기본 5분.
FUNDING_RESERVATION_TTL=5m
